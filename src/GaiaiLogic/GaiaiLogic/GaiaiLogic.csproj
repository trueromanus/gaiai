<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<NativeAot>enable</NativeAot>
		<IsTrimmable>true</IsTrimmable>
		<PublishTrimmed>true</PublishTrimmed>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableNETAnalyzers>True</EnableNETAnalyzers>
		<RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="DataFiles\Roads-en.json" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="DataFiles\NewsSection-en.json">
			<LogicalName>NewsSection-en.json</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="DataFiles\Houses-en.json">
			<LogicalName>Houses-en.json</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="DataFiles\LampPosts-en.json">
			<LogicalName>LampPosts-en.json</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="DataFiles\Roads-en.json">
			<LogicalName>Roads-en.json</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="DataFiles\TrafficLights-en.json">
			<LogicalName>TrafficLights-en.json</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="DataFiles\Emails-en.json">
			<LogicalName>EmailSection-en.json</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="TemplateFiles\ShutDownModal.html">
			<LogicalName>ShutDownModal.html</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="TemplateFiles\RunModal.html">
			<LogicalName>RunModal.html</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="TemplateFiles\ButtonTaskbar.html">
			<LogicalName>ButtonTaskbar.html</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="TemplateFiles\WindowModal.html">
			<LogicalName>WindowModal.html</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="TemplateFiles\ProgramsPopupMenu.html">
			<LogicalName>ProgramsPopupMenu.html</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="TemplateFiles\PopupMenu.html">
			<LogicalName>PopupMenu.html</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\..\..\..\..\SciterAPI\SciterAPI\src\EmptyFlow.SciterAPI\EmptyFlow.SciterAPI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="HTMLGameData\**" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(FileName)%(Extension)" />
	</ItemGroup>
</Project>
